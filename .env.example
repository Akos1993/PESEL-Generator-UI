# Azure Cosmos DB configuration
# Set one of the following to configure the connection:
# Option 1: Full Connection String (Recommended)
AZURE_COSMOS_CONNECTION_STRING=AccountEndpoint=https://your-cosmos-db.documents.azure.com:443/;AccountKey=your-account-key==;

# Option 2: Endpoint and Key separately
AZURE_COSMOS_ENDPOINT=https://your-cosmos-db.documents.azure.com:443/
AZURE_COSMOS_KEY=your-account-key==

# Optional Database and Container overrides (Defaults will be used if left blank)
AZURE_COSMOS_DATABASE=PeselMasterDb
AZURE_COSMOS_CONTAINER=Identities
